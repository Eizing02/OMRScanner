# Browser-safe Supabase connection; no real keys in this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Local synthetic workspace is explicit and disabled in production.
NEXT_PUBLIC_DEMO_MODE=true
# Default Scanic; set legacy then rebuild/redeploy for a detector-only rollback.
NEXT_PUBLIC_SCANNER_ENGINE=scanic
# Legacy worker variables are optional and unused by the in-process scanner.
OMR_WORKER_BASE_URL=
OMR_CHECKER_UPSTREAM_COMMIT=5cf44a5a9c7a49e2e541c6e19aefd09a41a4d494
# Images: private Supabase Storage school-logos / scan-images. No Cloudinary keys.
# Optional score publisher; disabled until the OTHER project's security/contract passes.
SCORE_INTEGRATION_ENABLED=false
MATHQUEST_RECEIVER_VERIFIED=false
MATHQUEST_RECEIVER_ORIGIN=
# Server-only fresh credential for integration RPCs. Never use an exposed old key.
SCORE_SYNC_SUPABASE_SECRET_KEY=
# JSON mapping of key version to 64 hex characters; retained versions decrypt old jobs.
SCORE_SYNC_ENCRYPTION_KEYS={}
SCORE_SYNC_ENCRYPTION_KEY_VERSION=
# Random >=32-character secret; protects the POST dispatcher from scheduler callers.
SCORE_SYNC_RUNNER_SECRET=
