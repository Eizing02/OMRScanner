# Browser-safe Supabase connection; no real keys in this file.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Local synthetic workspace is explicit and disabled in production.
NEXT_PUBLIC_DEMO_MODE=true
# Default Scanic; set legacy then rebuild/redeploy for a detector-only rollback.
NEXT_PUBLIC_SCANNER_ENGINE=scanic
# Legacy worker variables are optional and unused by the in-process scanner.
OMR_WORKER_BASE_URL=
OMR_CHECKER_UPSTREAM_COMMIT=5cf44a5a9c7a49e2e541c6e19aefd09a41a4d494
# Images: private Supabase Storage school-logos / scan-images. No Cloudinary keys.
